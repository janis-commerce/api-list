{
  "include": [
    "lib/"
  ],
  "exclude": [
    "lib/export/export-serverless-helper-hooks.js"
  ],
  "extension": [
    ".js"
  ],
  "cache": true,
  "all": true,
  "default-excludes": true,
  "check-coverage": true,
  "skip-full": true,
  "statements": 100,
  "branches": 99,
  "functions": 100,
  "lines": 100
}
